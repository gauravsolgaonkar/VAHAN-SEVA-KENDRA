PORT=4000
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/vsk
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# RC providers in priority order; the next one is used if the first fails or times out.
# Use "mock" until a real key is added, e.g. RC_PROVIDERS=surepass,mock
RC_PROVIDERS=mock
RC_TIMEOUT_MS=12000
RC_CACHE_DAYS=30
RC_RATE_LIMIT_PER_MINUTE=10
RC_DAILY_LIMIT_PER_USER=200
SUREPASS_TOKEN=
SUREPASS_COST=0
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# Reminder queue build time (IST)
REMINDER_CRON=0 8 * * *
